---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORIES, type CategoryKey } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

export function getStaticPaths() {
  return (Object.keys(CATEGORIES) as CategoryKey[]).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params as { category: CategoryKey };
const { label, color } = CATEGORIES[category];
const posts = await getPublishedPosts(category);
---

<BaseLayout title={label}>
  <h1 class="heading" style={`color: ${color}`}>{label}</h1>
  <PostList posts={posts} />
</BaseLayout>

<style>
  .heading {
    margin: 0 0 20px;
    font-size: 1.6rem;
  }
</style>
